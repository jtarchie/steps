[reviewer] +// runTryStep executes a try:-wrapped step. The inner step's real outcome is
[reviewer] +// recorded, its hooks fire normally, and its to: routing sees the truth — but
[reviewer] +// the plan continues regardless of failure.
[reviewer] +func runTryStep(
[reviewer] +    ctx context.Context,
[reviewer] +    cfg *config.Config,
[reviewer] +    jobName string,
[reviewer] +    i *int,
[reviewer] +    parentHash *string,
[reviewer] +    chainUnskippable *bool,
[reviewer] +    pending **agent.Handoff,
[reviewer] +    inner config.Step,
[reviewer] +    steps []config.Step,
[reviewer] +    bw workspace.BuildWorkspace,
[reviewer] +    st *store.Store,
[reviewer] +    skippable map[string]bool,
[reviewer] +    visits map[int]int,
[reviewer] +) (bool, error) {
[reviewer] +    newParentHash, disposition, no, err := runNonGetStep(ctx, cfg, jobName, *i, inner, bw, st, skippable, *parentHash, handoffFor(inner, *pending))
[reviewer] +
[reviewer] +    if disposition == stepRan {
[reviewer] +            visits[*i]++
[reviewer] +    }
[reviewer] +
[reviewer] +    nextIndex, routedKey, _, exhaustedErr := applyRouting(ctx, steps, *i, inner, disposition, no.verdict, err, visits)
[reviewer] +    if exhaustedErr != nil {
[reviewer] +            return true, exhaustedErr
[reviewer] +    }
[reviewer] +
[reviewer] +    // Routing matched: the error (if any) is consumed — advance to target.
[reviewer] +    if routedKey != "" {
[reviewer] +            var foldErr error
[reviewer] +            *chainUnskippable, foldErr = foldStepUnskippable(cfg, inner, *chainUnskippable)
[reviewer] +            if foldErr != nil {
[reviewer] +                    return true, foldErr
[reviewer] +            }
[reviewer] +            *pending = nextPendingHandoff(jobName, inner, steps, routedKey, no, visits, nextIndex)
[reviewer] +            *i = nextIndex
[reviewer] +
[reviewer] +            return false, nil
[reviewer] +    }
[reviewer] +
[reviewer] +    // Error not routed — swallow for try: and continue.
[reviewer] +    if err != nil {
[reviewer] +            reportTryFailure(jobName, inner, err, parentHash, newParentHash, chainUnskippable, cfg, i, nextIndex, pending)
[reviewer] +
[reviewer] +            return false, nil
[reviewer] +    }
[reviewer] +
[reviewer] +    // Step succeeded (or was guard-skipped/chain-skipped).
[reviewer] +    if disposition == stepChainSkipped {
[reviewer] +            reportChainSkipped(jobName, steps[*i+1:])
[reviewer] +
[reviewer] +            return true, nil
[reviewer] +    }
[reviewer] +
[reviewer] +    if disposition == stepGuardSkipped {
[reviewer] +            *pending = nil
[reviewer] +            *i = nextIndex
[reviewer] +
[reviewer] +            return false, nil
[reviewer] +    }
[reviewer] +
[reviewer] +    // stepRan, success
[reviewer] +    fmt.Printf("try: %s (succeeded)\n", executedStepName(inner))
[reviewer] +    tryAdvanceToNext(inner, parentHash, newParentHash, chainUnskippable, cfg, pending, i, nextIndex)
[reviewer] +
[reviewer] +    return false, nil
[reviewer] +}
[reviewer] +
[reviewer] +// reportTryFailure logs the try: failure and advances the loop index so the
