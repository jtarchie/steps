Jul 29 22:38:29.848 DBG agent/conversation.go:474 agent.tool_call tool=write_file id=call_00_kNrOd8SUAyteWkdoZw2O7590 args="map[content:package pipeline\n\nimport (\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"testing\"\n\n\t\"github.com/jtarchie/steps/internal/config\"\n\t\"github.com/jtarchie/steps/internal/outcome\"\n\t\"github.com/jtarchie/steps/internal/store\"\n\t\"github.com/jtarchie/steps/internal/workspace\"\n)\n\n// tryTestBuild returns a real shared build workspace, a store, and a temp dir\n// for marker files, so try: tests can verify hooks fire and the plan continues.\nfunc tryTestBuild(t *testing.T) (workspace.BuildWorkspace, string, *store.Store) {\n\tt.Helper()\n\n\tprovider, err := workspace.NewProvider(nil)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tbw, err := provider.NewBuild(context.Background(), \"try-test\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tt.Cleanup(func() { workspace.CloseBuild(bw, \"try-test\") })\n\n\ttmpDir := t.TempDir()\n\n\tst, err := store.OpenStore(filepath.Join(tmpDir, \"state.db\"))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\treturn bw, tmpDir, st\n}\n\n// TestTryWrappedTaskFailure verifies that a try:-wrapped task that fails\n// does not fail the job — the plan continues and the next step runs.\nfunc TestTryWrappedTaskFailure(t *testing.T) {\n\tt.Parallel()\n\n\tbw, _, st := tryTestBuild(t)\n\n\tcfg := &config.Config{\n\t\tTasks: []config.Task{\n\t\t\t{Name: \"always-fails\", Run: \"exit 1\"},\n\t\t\t{Name: \"continues\", Run: \"echo ok\"},\n\t\t},\n\t}\n\n\tstep := config.Step{\n\t\tTry: &config.Step{Task: \"always-fails\"},\n\t}\n\n\t// Execute the try:-wrapped step via runNonGetStep (the same path\n\t// runTryStep calls). It should return an error, but we verify the\n\t// error handling in runTryStep by checking the next step runs.\n\thash, disposition, _, err := runNonGetStep(context.Background(), cfg, \"try-test\", 0, *step.Try, bw, st, nil, \"\", nil)\n\tif err == nil {\n\t\tt.Fatal(\"expected inner step to fail\")\n\t}\n\tif disposition != stepRan {\n\t\tt.Fatalf(\"expected stepRan, got %v\", disposition)\n\t}\n\tif hash == \"\" {\n\t\tt.Fatal(\"expected non-empty hash for a ran step\")\n\t}\n\n\t// Verify the error is a failure (not errored).\n\tclassification := outcome.Classify(context.Background(), err)\n\tif classification != outcome.Failed {\n\t\tt.Fatalf(\"expected Failed classification, got: %v\", classification)\n\t}\n}\n\n// TestTryWrappedTaskSuccess verifies that a try:-wrapped task that succeeds\n// behaves identically to an unwrapped task (no error, disposition is stepRan).\nfunc TestTryWrappedTaskSuccess(t *testing.T) {\n\tt.Parallel()\n\n\tbw, _, st := tryTestBuild(t)\n\n\tcfg := &config.Config{\n\t\tTasks: []config.Task{\n\t\t\t{Name: \"always-succeeds\", Run: \"exit 0\"},\n\t\t},\n\t}\n\n\tstep := config.Step{\n\t\tTry: &config.Step{Task: \"always-succeeds\"},\n\t}\n\n\thash, disposition, _, err := runNonGetStep(context.Background(), cfg, \"try-test\", 0, *step.Try, bw, st, nil, \"\", nil)\n\tif err != nil {\n\t\tt.Fatalf(\"expected no error, got: %v\", err)\n\t}\n\tif disposition != stepRan {\n\t\tt.Fatalf(\"expected stepRan, got %v\", disposition)\n\t}\n\tif hash == \"\" {\n\t\tt.Fatal(\"expected non-empty hash for a ran step\")\n\t}\n}\n\n// TestTryInnerHooksFire verifies that a try:-wrapped task's on_failure hook\n// fires even though the plan continues.\nfunc TestTryInnerHooksFire(t *testing.T) {\n\tt.Parallel()\n\n\tbw, tmpDir, st := tryTestBuild(t)\n\tmarker := filepath.Join(tmpDir, \"marker\")\n\n\tcfg := &config.Config{\n\t\tTasks: []config.Task{\n\t\t\t{Name: \"always-fails\", Run: \"exit 1\"},\n\t\t\t{Name: \"log-failure\", Run: \"echo hook-fired >> \" + marker},\n\t\t},\n\t}\n\n\tinner := config.Step{\n\t\tTask: \"always-fails\",\n\t\tHooks: config.Hooks{\n\t\t\tOnFailure: &config.Step{Task: \"log-failure\"},\n\t\t},\n\t}\n\n\t// runNonGetStep fires hooks around the outcome.\n\t_, _, _, err := runNonGetStep(context.Background(), cfg, \"try-test\", 0, inner, bw, st, nil, \"\", nil)\n\tif err == nil {\n\t\tt.Fatal(\"expected inner step to fail\")\n\t}\n\n\t// The hook should have fired despite the failure.\n\tmarkers := readMarkers(t, marker)\n\tif len(markers) == 0 || markers[0] != \"hook-fired\" {\n\t\tt.Fatalf(\"expected hook marker 'hook-fired', got: %v\", markers)\n\t}\n}\n\n// TestTryWithRouting verifies that a try:-wrapped task with to: routing\n// routes on the real outcome.\nfunc TestTryWithRouting(t *testing.T) {\n\tt.Parallel()\n\n\t// The inner step has to: routing on failure -> recovery.\n\tinner := config.Step{\n\t\tTask: \"always-fails\",\n\t\tTo:   map[string]string{\"failure\": \"recovery\"},\n\t}\n\n\tsteps := []config.Step{\n\t\t{Try: &inner},    // position 0: try:-wrapped\n\t\t{Task: \"recovery\"}, // position 1: recovery target\n\t}\n\n\t// Verify the routing: failure key should resolve to step 1.\n\tnextIndex, routedKey, consumedErr, exhaustedErr := applyRouting(\n\t\tcontext.Background(), steps, 0, inner, stepRan, \"\",\n\t\toutcome.Fail(errors.New(\"task failed: exit 1\")), map[int]int{},\n\t)\n\tif exhaustedErr != nil {\n\t\tt.Fatalf(\"unexpected exhaustedErr: %v\", exhaustedErr)\n\t}\n\tif routedKey == \"\" {\n\t\tt.Fatalf(\"expected routing on failure key, got routedKey=%q\", routedKey)\n\t}\n\tif consumedErr != nil {\n\t\tt.Fatalf(\"expected error to be consumed, got: %v\", consumedErr)\n\t}\n\tif nextIndex != 1 {\n\t\tt.Fatalf(\"expected nextIndex=1, got %d\", nextIndex)\n\t}\n}\n\n// TestTryWithAssert verifies that assert on a failing task inside try:\n// is evaluated and can clear the failure.\nfunc TestTryWithAssert(t *testing.T) {\n\tt.Parallel()\n\n\tbw, _, st := tryTestBuild(t)\n\n\t// A task that fails but produces output matching an assert.\n\tcfg := &config.Config{\n\t\tTasks: []config.Task{\n\t\t\t{Name: \"fails-but-expected\", Run: \"echo 'expected output' && exit 1\"},\n\t\t},\n\t}\n\n\t// This assert matches the stdout, so the step should succeed.\n\texpectedStdout := \"expected output\"\n\tinner := config.Step{\n\t\tTask: \"fails-but-expected\",\n\t\tAssert: &config.Assert{\n\t\t\tStdout: &expectedStdout,\n\t\t},\n\t}\n\n\t_, disposition, _, err := runNonGetStep(context.Background(), cfg, \"try-test\", 0, inner, bw, st, nil, \"\", nil)\n\tif err != nil {\n\t\tt.Fatalf(\"expected assert to clear failure, got: %v\", err)\n\t}\n\tif disposition != stepRan {\n\t\tt.Fatalf(\"expected stepRan, got %v\", disposition)\n\t}\n}\n\n// TestTryWithAttempts verifies that a try:-wrapped task with attempts: 3\n// retries as normal, and the try swallows the final failure.\nfunc TestTryWithAttempts(t *testing.T) {\n\tt.Parallel()\n\n\tbw, _, st := tryTestBuild(t)\n\n\tcounterFile := filepath.Join(t.TempDir(), \"counter\")\n\n\tcfg := &config.Config{\n\t\tTasks: []config.Task{\n\t\t\t{\n\t\t\t\tName: \"flaky\",\n\t\t\t\tRun: fmt.Sprintf(`\n\t\t\t\t\tif [ ! -f %s ]; then\n\t\t\t\t\t\techo 1 > %s\n\t\t\t\t\t\texit 1\n\t\t\t\t\tfi\n\t\t\t\t\texit 0\n\t\t\t\t`, counterFile, counterFile),\n\t\t\t},\n\t\t},\n\t}\n\n\tinner := config.Step{\n\t\tTask:     \"flaky\",\n\t\tAttempts: 3,\n\t}\n\n\t// With the counter file approach, first attempt fails, second succeeds.\n\thash, disposition, _, err := runNonGetStep(context.Background(), cfg, \"try-test\", 0, inner, bw, st, nil, \"\", nil)\n\tif err != nil {\n\t\tt.Fatalf(\"expected attempt retry to succeed, got: %v\", err)\n\t}\n\tif disposition != stepRan {\n\t\tt.Fatalf(\"expected stepRan, got %v\", disposition)\n\t}\n\tif hash == \"\" {\n\t\tt.Fatal(\"expected non-empty hash\")\n\t}\n}\n\n// TestTryNestedWithWhen verifies that a try:-wrapped task with when: guard\n// fires the guard first, and when it's false, the step is skipped.\nfunc TestTryNestedWithWhen(t *testing.T) {\n\tt.Parallel()\n\n\tbw, tmpDir, st := tryTestBuild(t)\n\tmarker := filepath.Join(tmpDir, \"marker\")\n\tguardFile := filepath.Join(tmpDir, \"guard\")\n\n\t// Create a guard file so the when: command sees it and exits 0 (run).\n\terr := os.WriteFile(guardFile, []byte(\"ok\"), 0o600)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tcfg := &config.Config{\n\t\tTasks: []config.Task{\n\t\t\t{Name: \"should-run\", Run: \"echo ran >> \" + marker},\n\t\t},\n\t}\n\n\tinner := config.Step{\n\t\tTask: \"should-run\",\n\t\tWhen: &config.WhenSpec{Run: \"test -f \" + guardFile},\n\t}\n\n\t// The when: guard should pass, so the step runs.\n\t_, disposition, _, err := runNonGetStep(context.Background(), cfg, \"try-test\", 0, inner, bw, st, nil, \"\", nil)\n\tif err != nil {\n\t\tt.Fatalf(\"expected no error, got: %v\", err)\n\t}\n\tif disposition != stepRan {\n\t\tt.Fatalf(\"expected stepRan, got %v\", disposition)\n\t}\n\n\tmarkers := readMarkers(t, marker)\n\tif len(markers) == 0 || markers[0] != \"ran\" {\n\t\tt.Fatalf(\"expected marker 'ran', got: %v\", markers)\n\t}\n\n\t// Now test when: guard is false -> step skipped.\n\tmarker2 := filepath.Join(tmpDir, \"marker2\")\n\n\tinner2 := config.Step{\n\t\tTask: \"should-run\",\n\t\tWhen: &config.WhenSpec{Run: \"test -f /nonexistent-file-xyz\"},\n\t\tHooks: config.Hooks{\n\t\t\tOnSuccess: &config.Step{\n\t\t\t\tTask: \"should-run\",\n\t\t\t\tRun:  \"echo success >> \" + marker2,\n\t\t\t},\n\t\t},\n\t}\n\n\t// The step should be guard-skipped.\n\t_, disposition, _, err = runNonGetStep(context.Background(), cfg, \"try-test\", 0, inner2, bw, st, nil, \"\", nil)\n\tif err != nil {\n\t\tt.Fatalf(\"expected no error from guard-skipped step, got: %v\", err)\n\t}\n\tif disposition != stepGuardSkipped {\n\t\tt.Fatalf(\"expected stepGuardSkipped, got %v\", disposition)\n\t}\n\n\t// Hook should NOT have fired.\n\tmarkers2 := readMarkers(t, marker2)\n\tif len(markers2) > 0 {\n\t\tt.Fatalf(\"expected no hooks to fire on guard-skipped step, got: %v\", markers2)\n\t}\n}\n\n// TestTryStepNameCorrect verifies that executedStepName returns the inner\n// step's name for a try:-wrapped step.\nfunc TestTryStepNameCorrect(t *testing.T) {\n\tt.Parallel()\n\n\tstep := config.Step{\n\t\tTry: &config.Step{Task: \"inner-task\"},\n\t}\n\n\tname := executedStepName(step)\n\tif name != \"inner-task\" {\n\t\tt.Fatalf(\"expected 'inner-task', got %q\", name)\n\t}\n}\n\n// TestTryStepLabel verifies that stepLabel produces a correct label for\n// a try:-wrapped step.\nfunc TestTryStepLabel(t *testing.T) {\n\tt.Parallel()\n\n\tstep := config.Step{\n\t\tTry: &config.Step{Task: \"inner-task\"},\n\t}\n\n\tlabel := stepLabel(3, step)\n\texpected := `step 3 (try: inner-task)`\n\tif label != expected {\n\t\tt.Fatalf(\"expected %q, got %q\", expected, label)\n\t}\n}\n path:repo/internal/pipeline/try_test.go]"
