{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jtarchie/steps/steps.schema.json",
  "title": "steps pipeline",
  "description": "A Concourse-style pipeline with LLM agent steps. Add `# yaml-language-server: $schema=./steps.schema.json` at the top of a pipeline file for editor completion and validation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "defaults": {
      "$ref": "#/$defs/defaults"
    },
    "resource_types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resourceType"
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/agent"
      }
    },
    "mcp_servers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mcpServer"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/job"
      }
    },
    "workspace": {
      "$ref": "#/$defs/workspace"
    },
    "assert": {
      "$ref": "#/$defs/assert"
    }
  },
  "$defs": {
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "description": "Pipeline-wide fallbacks. $STEPS_MODEL overrides model.",
      "properties": {
        "model": {
          "type": "string",
          "description": "source.model for any agent that names none."
        },
        "preflight": {
          "type": "object",
          "additionalProperties": false,
          "description": "The pre-run health check of a job's models and MCP servers. On by default.",
          "properties": {
            "disabled": {
              "type": "boolean",
              "description": "Skip the check entirely."
            },
            "timeout": {
              "type": "string",
              "description": "Per-check deadline, e.g. 30s. Default 30s."
            },
            "cache": {
              "type": "string",
              "description": "How long a verified target stays trusted, e.g. 5m. Keeps steps watch from probing every poll. Default 5m."
            }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "description": "Pipeline-wide run-context settings.",
          "properties": {
            "fidelity": {
              "enum": ["off", "truncate", "compact", "summary"],
              "description": "Default recap detail for every agent step. A step's own context.fidelity wins. Default compact."
            }
          }
        }
      }
    },
    "resourceType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "config"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "image": {
          "type": "string",
          "description": "Run check/in/out in this container image instead of on the host."
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "check": {
              "type": "string",
              "description": "Prints a JSON array of version objects, oldest first."
            },
            "in": {
              "type": "string",
              "description": "Fetches one version into the (empty) working directory."
            },
            "out": {
              "type": "string",
              "description": "Publishes. Omit to make the type read-only; a put against it is then an error."
            },
            "mcp": {
              "$ref": "#/$defs/mcpResourceConfig"
            }
          }
        }
      }
    },
    "mcpResourceConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server",
        "check"
      ],
      "description": "Back check/in/out with MCP tool calls instead of shell commands. Mutually exclusive with check/in/out.",
      "properties": {
        "server": {
          "type": "string"
        },
        "check": {
          "$ref": "#/$defs/mcpToolCall"
        },
        "in": {
          "$ref": "#/$defs/mcpToolCall"
        },
        "out": {
          "$ref": "#/$defs/mcpToolCall"
        }
      }
    },
    "mcpToolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool"
      ],
      "properties": {
        "tool": {
          "type": "string"
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "A resource_types: entry, or the built-in `git`."
        },
        "source": {
          "type": "object",
          "description": "Type-specific configuration, available as {{ .source.* }}."
        },
        "webhook_token_env": {
          "type": "string",
          "description": "Environment variable holding the shared secret a webhook must present to trigger an immediate check of this resource. The variable NAME, never the token itself."
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/agentSource"
        },
        "budget": {
          "$ref": "#/$defs/budget"
        },
        "preflight": {
          "type": "boolean",
          "description": "Opt this agent out of (or into) the pre-run health check. For a model expected to be slow to wake."
        },
        "fallback": {
          "type": "array",
          "description": "Alternate sources to use, in order, when the primary model is unreachable. Selected at preflight; never affects the step's cache key.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source"
            ],
            "properties": {
              "source": {
                "$ref": "#/$defs/agentSource"
              }
            }
          }
        },
        "description": {
          "type": "string",
          "description": "Required when this agent is granted as a sub-agent tool."
        },
        "file": {
          "type": "string",
          "description": "Load this agent from a YAML document; inline fields win."
        },
        "image": {
          "type": "string"
        },
        "system": {
          "type": "string"
        },
        "system_file": {
          "type": "string",
          "description": "Load system from a file, or @builtin/<name>."
        },
        "temperature": {
          "type": "number"
        },
        "top_p": {
          "type": "number"
        },
        "max_tokens": {
          "type": "integer"
        },
        "reasoning_effort": {
          "type": "string"
        },
        "max_turns": {
          "type": "integer",
          "description": "Tool-calling turns per attempt. Default 8."
        },
        "compact_after_tokens": {
          "type": "integer",
          "description": "Compact the conversation past this size. 0 disables."
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolSpec"
          }
        }
      }
    },
    "agentSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "description": "Provider-prefixed, e.g. openai/gpt-4o or lmstudio/qwen. An @-prefixed value (e.g. \"@claude/sonnet\", quoted -- @ is reserved in YAML) runs a coding-agent CLI as a subprocess instead of calling an endpoint; endpoint:, the generation dials, compact_after_tokens:, budget.tokens:, and image: do not apply to one (use budget.usd: instead)."
        },
        "endpoint": {
          "type": "string",
          "description": "Required when the model has no known provider prefix."
        },
        "api_key_env": {
          "type": "string",
          "description": "Environment variable holding the key. Never the key itself."
        },
        "string_tool_choice": {
          "type": "boolean"
        }
      }
    },
    "toolSpec": {
      "description": "A builtin name, a custom command-backed tool, a sub-agent, or an MCP grant.",
      "oneOf": [
        {
          "type": "string",
          "description": "A built-in tool by name.",
          "enum": [
            "read_file",
            "list_dir",
            "run_shell",
            "write_file",
            "edit_file",
            "search_files"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "builtin"
          ],
          "properties": {
            "builtin": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "run"
          ],
          "description": "A custom tool backed by a shell command.",
          "properties": {
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "run": {
              "type": "string",
              "description": "sh -c template; {{ .args.X }} interpolated. Use | shellquote."
            },
            "required": {
              "type": "boolean",
              "description": "The step cannot finish until this succeeds once."
            },
            "max_calls": {
              "type": "integer"
            },
            "max_output_bytes": {
              "type": "integer"
            },
            "args": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Pinned arguments the model can neither see nor set."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agent"
          ],
          "description": "Expose another agent as a callable tool.",
          "properties": {
            "agent": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mcp"
          ],
          "description": "Grant tools from an mcp_servers: entry: one (tool:), a subset (tools:), or all.",
          "properties": {
            "mcp": {
              "type": "string"
            },
            "tool": {
              "type": "string"
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": {
              "type": "string"
            },
            "required": {
              "type": "boolean"
            },
            "max_calls": {
              "type": "integer"
            },
            "max_output_bytes": {
              "type": "integer"
            }
          }
        }
      ]
    },
    "mcpServer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "endpoint": {
          "type": "string",
          "description": "HTTP transport. Mutually exclusive with command."
        },
        "command": {
          "type": "string",
          "description": "stdio transport: a subprocess to run."
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "command only."
        },
        "cwd": {
          "type": "string",
          "description": "command only."
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "none",
                "bearer",
                "oauth"
              ]
            },
            "api_key_env": {
              "type": "string",
              "description": "bearer only."
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "run": {
          "type": "string"
        },
        "run_file": {
          "type": "string",
          "description": "Mutually exclusive with run."
        },
        "file": {
          "type": "string",
          "description": "Load this task from a YAML document; inline fields win."
        },
        "fix": {
          "$ref": "#/$defs/fixSpec"
        },
        "image": {
          "type": "string"
        },
        "timeout": {
          "type": "string",
          "description": "Go duration, e.g. 2m."
        },
        "inputs": {
          "$ref": "#/$defs/inputSpecNames"
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "fixSpec": {
      "description": "An agent to invoke when the task's run: exits non-zero.",
      "oneOf": [
        {
          "type": "string",
          "description": "The agent's name."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agent"
          ],
          "properties": {
            "agent": {
              "type": "string"
            },
            "prompt": {
              "type": "string"
            },
            "prompt_file": {
              "type": "string"
            },
            "dir": {
              "type": "string"
            },
            "tools": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/toolSpec"
              }
            },
            "attempts": {
              "type": "integer"
            },
            "timeout": {
              "type": "string"
            }
          }
        }
      ]
    },
    "inputSpec": {
      "description": "Artifact names this step reads, or the scalar `all` (put steps only).",
      "oneOf": [
        {
          "const": "all"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "inputSpecNames": {
      "description": "Artifact names. `all` is not valid on a tasks: entry.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "plan"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "plan": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "assert": {
          "$ref": "#/$defs/assert"
        },
        "budget": {
          "$ref": "#/$defs/budget"
        },
        "serial": {
          "type": "boolean",
          "description": "State that two builds of this job must never run at once. Always true in practice — this records that a pipeline depends on it."
        },
        "serial_groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Locks this job holds while it runs. Two jobs sharing a group never run at the same time."
        },
        "max_consecutive_failures": {
          "type": "integer",
          "minimum": 1,
          "description": "Pause this job under steps watch after this many consecutive failed triggered runs. Resume with: steps jobs resume <name>. Omit for no circuit breaker."
        },
        "on_success": {
          "$ref": "#/$defs/step"
        },
        "on_failure": {
          "$ref": "#/$defs/step"
        },
        "on_error": {
          "$ref": "#/$defs/step"
        },
        "on_abort": {
          "$ref": "#/$defs/step"
        },
        "ensure": {
          "$ref": "#/$defs/step"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "description": "Exactly one of get/task/put/agent.",
      "properties": {
        "get": {
          "type": "string"
        },
        "trigger": {
          "type": "boolean",
          "description": "get only: poll this in `steps watch`."
        },
        "version": {
          "description": "get only: `latest` (default), `every`, or a pinned version object."
        },
        "resource": {
          "type": "string",
          "description": "get only: the resource to fetch when it differs from the step's name."
        },
        "task": {
          "type": "string"
        },
        "run": {
          "type": "string",
          "description": "task only. Present means inline; absent means task: names a tasks: entry."
        },
        "run_file": {
          "type": "string"
        },
        "fix": {
          "$ref": "#/$defs/fixSpec"
        },
        "input_mapping": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "output_mapping": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "put": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "description": "put only: passed to the out command as {{ .params.* }}."
        },
        "agent": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "prompt_file": {
          "$ref": "#/$defs/fileRef"
        },
        "dir": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolSpec"
          }
        },
        "attempts": {
          "type": "integer"
        },
        "context_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verdicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "handoff": {
          "$ref": "#/$defs/handoffSpec"
        },
        "context": {
          "$ref": "#/$defs/contextSpec"
        },
        "timeout": {
          "type": "string",
          "description": "Go duration, per attempt."
        },
        "try": {
          "$ref": "#/$defs/step",
          "description": "Wrap a step so its failure is tolerated. The inner step's hooks and assert fire normally; to: routing sees the real outcome."
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "message"
          ],
          "description": "Pause the plan until a person approves or rejects.",
          "properties": {
            "message": {
              "type": "string",
              "description": "What is being asked. Required — an approval nobody can read is one nobody can answer responsibly."
            },
            "timeout": {
              "type": "string",
              "description": "How long to wait, e.g. 24h. An expired approval classifies as aborted, not failed."
            }
          }
        },
        "load_var": {
          "type": "string",
          "description": "Capture the contents of file: into a pipeline var later steps reference as ((name))."
        },
        "file": {
          "type": "string",
          "description": "load_var steps only: the workspace-relative file to read the value from."
        },
        "passed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "get steps only. Only run against a version that has already succeeded in every named upstream job."
        },
        "across": {
          "type": "array",
          "minItems": 1,
          "description": "Run this step once per combination of values, substituting {{ .vars.<name> }} into run/image/prompt/dir and the step's name. A values: axis expands at load; a from: axis expands at run time. Each cell caches independently.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "var"
            ],
            "oneOf": [
              {
                "required": [
                  "values"
                ]
              },
              {
                "required": [
                  "from"
                ]
              }
            ],
            "properties": {
              "var": {
                "type": "string"
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "from": {
                "type": "string",
                "description": "Run-context key holding a JSON array recorded by an earlier step: all strings, or all flat objects whose fields a cell names individually ({{ .vars.finding.file }}). Mutually exclusive with values."
              },
              "label": {
                "type": "string",
                "description": "from: axes holding objects only. Which field names each cell; absent, cells are named by their 1-based position (#3)."
              }
            }
          }
        },
        "max_in_flight": {
          "type": "integer",
          "minimum": 1,
          "description": "across: steps only. How many cells may run at once. Unset or 1 runs them serially in declaration order; above 1 requires a top-level workspace: strategy. Not hashed — changing it never re-runs a cached cell.",
          "default": 1
        },
        "in_parallel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "steps"
          ],
          "description": "Run several steps at the same time instead of one after another.",
          "properties": {
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/step"
              }
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum branches in flight at once. Omit for unbounded."
            },
            "fail_fast": {
              "type": "boolean",
              "description": "Cancel the remaining branches as soon as one fails. The block fails either way."
            }
          }
        },
        "ensemble": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agents",
            "verdicts",
            "decide"
          ],
          "description": "Ask several agents the same question at once and combine their answers into one verdict to route on. Costs N times one agent.",
          "properties": {
            "agents": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/step"
              }
            },
            "verdicts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              },
              "description": "The vocabulary every member votes in, in precedence order for decide: any."
            },
            "decide": {
              "type": "string",
              "description": "majority, unanimous, any, or the name of an agent that judges."
            },
            "member_errors": {
              "type": "string",
              "enum": [
                "fail",
                "exclude"
              ],
              "description": "What a member that failed rather than voted does to the block. Default fail."
            }
          }
        },
        "race": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "steps"
          ],
          "description": "Run several steps at once and keep whichever finishes successfully first. A LATENCY hedge: both branches are always billed. Requires workspace isolation, and every branch must declare the same outputs.",
          "properties": {
            "steps": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/step"
              }
            }
          }
        },
        "inputs": {
          "$ref": "#/$defs/inputSpec"
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "image": {
          "type": "string"
        },
        "when": {
          "$ref": "#/$defs/whenSpec"
        },
        "to": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Route by outcome: success/failure, or a verdict name. Each value is a step name in the same get-segment, or the reserved target \"next\" — continue in declaration order, which is the only way to land on a container (in_parallel/race/across/ensemble/approval), since those have no name."
        },
        "max_visits": {
          "type": "integer",
          "description": "Required when any to: target routes backward."
        },
        "assert": {
          "$ref": "#/$defs/assert"
        },
        "on_success": {
          "$ref": "#/$defs/step"
        },
        "on_failure": {
          "$ref": "#/$defs/step"
        },
        "on_error": {
          "$ref": "#/$defs/step"
        },
        "on_abort": {
          "$ref": "#/$defs/step"
        },
        "ensure": {
          "$ref": "#/$defs/step"
        }
      }
    },
    "whenSpec": {
      "description": "A guard command. Exit 0 runs the step, non-zero skips it.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run"
          ],
          "properties": {
            "run": {
              "type": "string"
            }
          }
        }
      ]
    },
    "contextSpec": {
      "description": "What this agent step does with the run's shared key/value store. Reading is automatic; writing is opt-in.",
      "oneOf": [
        {
          "const": "write",
          "description": "Shorthand for { write: true }."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "write": {
              "type": "boolean",
              "description": "Grant the set_context tool, which records a fact for later steps."
            },
            "fidelity": {
              "enum": ["off", "truncate", "compact", "summary"],
              "description": "How much of the recorded context this step is shown. Defaults to compact; off opts out entirely."
            },
            "qualify": {
              "type": "boolean",
              "description": "On an across: step, record a fact PER CELL: each cell writes to its own scope and the join merges them under keys naming the cell. Required by max_in_flight > 1, and applied serially too, so the key names never depend on scheduling."
            }
          }
        }
      ]
    },
    "handoffSpec": {
      "description": "What this agent step exchanges with the steps around it. context/tool look backward along a route; note looks forward along the plan.",
      "oneOf": [
        {
          "type": "boolean",
          "description": "Shorthand for { context: true }."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "context": {
              "type": "boolean",
              "description": "Receive a <transition_context> block on routed entry."
            },
            "tool": {
              "type": "boolean",
              "description": "Receive a previous_run tool."
            },
            "note": {
              "type": "boolean",
              "description": "Write a handoff note for the next agent step."
            }
          }
        }
      ]
    },
    "fileRef": {
      "description": "A pipeline-relative path, or a file inside a declared input artifact.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact",
            "path"
          ],
          "properties": {
            "artifact": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          }
        }
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "A ceiling on what agent work may spend. On an agent it is per invocation; on a job it is the cumulative total across every agent step. Never hashed. Use tokens: for a hosted agent and usd: for a CLI agent (@claude/...) -- each runner meters only the unit it can enforce, and the other spelling is rejected.",
      "properties": {
        "tokens": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum provider-reported tokens, for a hosted agent or a job. Omit budget: entirely for no ceiling; 0 is rejected."
        },
        "usd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Maximum dollars, for a CLI agent only -- the CLI enforces it mid-conversation. Omit budget: entirely for no ceiling; 0 is rejected."
        }
      }
    },
    "assert": {
      "type": "object",
      "additionalProperties": false,
      "description": "Position decides which fields are legal: execution on a job/pipeline, outcome on a job, stdout/code on a task step, stdout/tool_calls on an agent step.",
      "properties": {
        "execution": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outcome": {
          "type": "string",
          "enum": [
            "succeeded",
            "failed"
          ],
          "description": "Job asserts only. What the plan must have CONCLUDED, as opposed to which steps ran. failed: requires an error and then clears it; succeeded: requires none, and opts out of the rule that a matching execution: clears a failure."
        },
        "stdout": {
          "type": "string"
        },
        "code": {
          "type": "integer"
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "args": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy"
      ],
      "description": "Opt into per-step isolation. Absent means every step in a build shares one directory.",
      "properties": {
        "strategy": {
          "enum": [
            "copy",
            "btrfs"
          ]
        },
        "root": {
          "type": "string",
          "description": "Required for btrfs."
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "compression": {
              "enum": [
                "zstd",
                "lzo",
                "zlib",
                "none"
              ]
            }
          }
        }
      }
    }
  }
}
