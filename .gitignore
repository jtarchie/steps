# Compiled binary (module name)
/steps

# `go build ./...` drops the tools/ checkers here
/kindswitch

# goreleaser build output
/dist/

# Persisted job-run state (sqlite)
.steps/
.scratch/

# Impeccable per-developer overrides (hook consent, local ignores)
.impeccable/config.local.json
# Local credentials for running the examples/self-build experiment (direnv)
.envrc
.DS_Store

# golangci-lint's lock lives at $TMPDIR/golangci-lint.lock, so `task lint`
# points TMPDIR here: two checkouts linting at once cannot then block each
# other. See the lint task.
.golangci-tmp/

# task cover-diff scratch profile
/.cover.out

# hack/aws-fixture.sh's cross-compiled worker binary
/.aws-fixture/

# scratch a shim writes if it is ever handed a relative root
steps-shim/
